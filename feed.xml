---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} — Recently updated software</title>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}/</id>
  <author><name>{{ site.author }}</name></author>
{% assign recent = site.downloads | sort: "modified_date" | reverse %}{% for d in recent limit: 20 %}  <entry>
    <title>{{ d.name | xml_escape }}</title>
    <link href="{{ site.url }}{{ d.url }}"/>
    <id>{{ site.url }}{{ d.url }}</id>
    {% assign mdp = d.modified_date | split: "/" %}{% if mdp.size == 3 %}<updated>{{ mdp[2] }}-{{ mdp[0] }}-{{ mdp[1] }}T00:00:00+00:00</updated>{% else %}<updated>{{ site.time | date_to_xmlschema }}</updated>{% endif %}
    <summary>{{ d.description | strip_html | xml_escape | truncate: 200 }}</summary>
  </entry>
{% endfor %}</feed>
